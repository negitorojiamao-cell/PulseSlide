<Window x:Class="PulseSlide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseSlide"
        Height="640" Width="820" MinHeight="600" MinWidth="740"
        WindowStartupLocation="CenterScreen" Background="#FF0D1017" Foreground="#FFF4F7FF">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF4F7FF"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,7,0,16"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#FF252D3B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF465267"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="♫  PulseSlide" FontSize="30" FontWeight="Bold" Foreground="#FF35E6FF"/>
            <TextBlock Text="音に反応して、画面の端からスライドするオーディオビジュアライザー" Margin="0,5,0,20" Foreground="#FFAAB5C8" FontSize="13"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FF171D28" BorderBrush="#FF2D3748" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="● 初期化中..." FontWeight="SemiBold" Foreground="#FF35E6FF"/>
                <TextBlock Text="Windowsの出力音声を検出。周波数帯域・波形・低音の変化をリアルタイム解析します。" TextWrapping="Wrap" Foreground="#FFB7C1D2" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="表示する端" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox x:Name="EdgeBox" SelectedIndex="0">
                    <ComboBoxItem Content="上 (Top)"/><ComboBoxItem Content="下 (Bottom)"/><ComboBoxItem Content="左 (Left)"/><ComboBoxItem Content="右 (Right)"/>
                </ComboBox>
                <TextBlock Text="ビジュアライザー" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox x:Name="StyleBox" SelectedIndex="0">
                    <ComboBoxItem Content="Neon Bars — ネオンバー"/>
                    <ComboBoxItem Content="Wave — 波形"/>
                    <ComboBoxItem Content="Spectrum — スペクトラム"/>
                    <ComboBoxItem Content="Circular — サークル・放射状"/>
                    <ComboBoxItem Content="VU Meter — アナログ針"/>
                    <ComboBoxItem Content="Beat Pulse — ビートパルス・3D風"/>
                </ComboBox>
                <TextBlock Text="発光色" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox x:Name="ColorBox" SelectedIndex="0">
                    <ComboBoxItem Content="Cyan — シアン"/><ComboBoxItem Content="Magenta — マゼンタ"/><ComboBoxItem Content="Lime — ライム"/><ComboBoxItem Content="Purple — パープル"/><ComboBoxItem Content="White — ホワイト"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="反応感度" FontSize="14" FontWeight="SemiBold"/>
                <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="12" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,6"/>
                <TextBlock Text="大きいほど小さな音にも反応" Foreground="#FF9CA8BA" FontSize="12" Margin="0,0,0,20"/>
                <TextBlock Text="無音になってから隠れるまで" FontSize="14" FontWeight="SemiBold"/>
                <Slider x:Name="DelaySlider" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,6"/>
                <TextBlock x:Name="DelayLabel" Text="3 秒" Foreground="#FF9CA8BA" FontSize="12"/>
                <TextBlock Text="表示テストで各スタイルをプレビューできます。" TextWrapping="Wrap" Foreground="#FF9CA8BA" FontSize="12" Margin="0,22,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="表示テスト" Click="Test_Click"/>
            <Button Content="適用" Click="Apply_Click" Background="#FF087E9B" BorderBrush="#FF35E6FF"/>
        </StackPanel>
    </Grid>
</Window>